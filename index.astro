---
import '../styles/global.css';
import '../scripts/invitation.js';
const title = 'Syed Saina Tasneem & Syed Nizamuddin | Nikkah Invitation';
const description = 'Digital Nikkah & Valima invitation for Syed Saina Tasneem and Syed Nizamuddin.';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#ead6e5"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="/images/og-cover.svg"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body>
<section class="opening" id="opening"><button class="open-invitation" id="openInvitation"><span class="open-circle"><i></i></span><span>OPEN INVITATION</span></button></section>
<button class="music-toggle" id="musicToggle" type="button" aria-label="Toggle music">♪</button><audio id="weddingMusic" loop preload="none"></audio>
<div class="invitation" id="invitation" aria-hidden="true">
<header class="hero" id="hero"><div class="curtain-layer"></div><div class="top-swag"></div><div class="floral-corner left"></div><div class="floral-corner right"></div><img class="chandelier" src="/images/chandelier.svg" alt=""/><img class="candelabras" src="/images/candelabras.svg" alt=""/><div class="hero-bokeh"></div><div class="hero-copy"><h1><span>Syed Saina Tasneem</span><em>&amp;</em><span>Syed Nizamuddin</span></h1><img class="rings" src="/images/rings.svg" alt=""/><button class="scroll-pill" data-scroll="#welcome">SCROLL DOWN <b>⌄</b></button></div><div class="flower-bed"></div></header>
<main>
<section class="welcome section" id="welcome"><p class="arabic-bismillah" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ</p><p class="english-bismillah">IN THE NAME OF ALLAH, THE MOST GRACIOUS<br/>THE MOST MERCIFUL</p><p class="welcome-copy">With the blessings of Almighty Allah,<br/>Together with their families, we cordially<br/>invite you to celebrate the Nikkah &amp;<br/>Valima ceremony of</p></section>
<section class="people section"><article class="person" data-reveal><span class="label">THE BRIDE</span><h2>Syed Saina<br/>Tasneem</h2><p class="qualification">M.A</p><span class="rule"></span><span class="relation">DAUGHTER OF</span><strong>Mrs. &amp; Mr. Dr. Syed Shaker Arif</strong><small>M.A., M.Ed., SET, Ph.D.<br/>Class I Officer, Education Department, Nanded</small></article><div class="ampersand">&amp;</div><article class="person" data-reveal><span class="label">THE GROOM</span><h2>Syed Nizamuddin</h2><p class="qualification">B.Com. (Computers), KSA</p><span class="rule"></span><span class="relation">SON OF</span><strong>Mrs. &amp; Mr. Syed Azam Sahab</strong><small>M.Tech. (Structures)</small></article></section>
<section class="date section" id="date"><p class="instruction">Scratch all three circles</p><button class="reveal" id="revealDate">✦ &nbsp; REVEAL DATE</button><h2>SCRATCH TO DISCOVER THE DATE</h2><div class="date-art"><img src="/images/four-women-lineart.svg" alt=""/><div class="date-hearts"><button data-reveal-heart>18th</button><button data-reveal-heart>September</button><button data-reveal-heart>2026</button></div></div><div class="save-date"><span>SAVE THE DATE</span><strong>18 . 09 . 2026</strong></div><div class="countdown" data-wedding-date="2026-09-18T20:00:00+05:00"><div><strong data-unit="days">00</strong><small>DAYS</small></div><div><strong data-unit="hours">00</strong><small>HOURS</small></div><div><strong data-unit="minutes">00</strong><small>MINUTES</small></div><div><strong data-unit="seconds">00</strong><small>SECS</small></div></div></section>
<section class="events section" id="events"><p class="eyebrow">PROGRAM DETAILS</p><h2 class="section-heading">Events &amp; Venues</h2><article class="event-card" data-reveal><span class="event-tag">✦ NIKKAH CEREMONY ✦</span><img src="/images/mosque.svg" class="event-art" alt=""/><h3>Friday, 18th September 2026</h3><p class="event-time">◷ After Namaz-e-Asar</p><p class="event-venue">📍 Masjid-e-Ilahi</p><p class="event-address">Shobha Nagar, Nanded</p><a href="[PLACEHOLDER-NIKKAH-MAPS]" class="location-button">📍 &nbsp; View Location on Google Maps</a></article><article class="event-card" data-reveal><span class="event-tag">✦ NIKAH DINNER ✦</span><img src="/images/hall.svg" class="event-art hall" alt=""/><h3>Friday, 18th September 2026</h3><p class="event-time">◷ <strong>8:00 PM</strong></p><p class="event-venue">📍 Prince Lawns Function Hall</p><p class="event-address">Maltekdi, Opp. Fruit Market, Nanded</p><a href="[PLACEHOLDER-DINNER-MAPS]" class="location-button">📍 &nbsp; View Location on Google Maps</a></article><article class="valima" data-reveal><p class="valima-tag">✦ ♛ VALIMA DINNER ♛ ✦</p><h3>Sunday, 20th September 2026</h3><p class="event-time">◷ <strong>9:00 PM</strong></p><p class="event-venue">📍 Nizam Palace Function Hall</p><p class="event-address">Bodhan Road, Nizamabad</p><a href="[PLACEHOLDER-VALIMA-MAPS]" class="location-button">📍 &nbsp; View Location on Google Maps</a></article></section>
<section class="rsvp section"><h2>Will You Join Our Big Day?</h2><p>Join us as we step into our forever</p><div class="rsvp-actions"><button data-rsvp="yes">I'll Be There ❤️</button><button data-rsvp="no">Will Miss It 😢</button></div><div class="rsvp-response" id="rsvpResponse" hidden></div></section>
<section class="compliments section"><p class="eyebrow">WITH BEST<br/>COMPLIMENTS FROM</p><div class="flourish">✦</div><div class="names"><p>Syed Zaker Arif<small>ADVOCATE, M.A., LL.B., NANDED</small></p><p>Syed Sajid Arif<small>DISTRICT JUDGE, LATUR</small></p><p>Syed Aqib</p><p>Syed Atif</p><p>Syed Farhan</p><p>Shaikh Aslam</p><p>Shaikh Khurram</p></div><p class="neat">✦ Neat &amp; Dear ✦</p></section>
<section class="thankyou section"><div class="envelope"><div class="env-body"></div><div class="env-flap"></div><div class="letter"><span>Thank You</span><small>For your blessings &amp; love</small><i>♡</i></div></div><p>[PLACEHOLDER — CLOSING MESSAGE]</p></section>
</main><footer class="footer"><div>◎ @awesome_creation</div><small>CONNECT FOR YOUR DIGITAL INVITATION</small></footer></div></body></html>
